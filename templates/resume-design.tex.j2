\cvsection{01}{Core expertise}
{% for row in skills | batch(2, none) %}
\noindent\begin{minipage}[t]{0.48\linewidth}\vspace{0pt}
{% if row[0] %}\cvskill{ {{ row[0].category | latex }} }{ {{ row[0]['items'] | map('latex') | join('  /  ') }} }{% endif %}
\end{minipage}\hfill\begin{minipage}[t]{0.48\linewidth}\vspace{0pt}
{% if row[1] %}\cvskill{ {{ row[1].category | latex }} }{ {{ row[1]['items'] | map('latex') | join('  /  ') }} }{% endif %}
\end{minipage}\par\vspace{8pt}
{% endfor %}

%----------------------------------------------------------------------------------------
%   EXPERIENCE
%----------------------------------------------------------------------------------------
\cvsection{02}{Professional experience}
{% for exp in experiences %}
\cvrole{ {{ exp.dates | latex }} }{ {{ exp.role | latex }} }{ {{ exp.company | latex }} }{ {{ exp.location | latex }} }{ {{ exp.summary | latex }} }
