%----------------------------------------------------------------------------------------
{% if projects %}
\cvsection{03}{Selected project}
{% for proj in projects %}
\cvproject{ {{ proj.name | latex }} }{\href{ {{ proj.link | url }} }{ {{ proj.link | display_url | latex }} }}{
{% for bullet in proj.bullets %}\item {{ bullet | latex }}
{% endfor %}
}{ {% for tech in proj.technologies %}{{ tech | latex }}{% if not loop.last %} \enspace / \enspace {% endif %}{% endfor %} }
{% endfor %}
{% endif %}

