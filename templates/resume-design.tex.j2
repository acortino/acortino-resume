{% for bullet in exp.bullets %}\item {{ bullet | latex }}
{% endfor %}
}{ {% for tech in exp.technologies %}{{ tech | latex }}{% if not loop.last %} \enspace / \enspace {% endif %}{% endfor %} }
{% endfor %}

%----------------------------------------------------------------------------------------
