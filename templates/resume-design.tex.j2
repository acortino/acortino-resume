%----------------------------------------------------------------------------------------
%  COMMANDS
%----------------------------------------------------------------------------------------
{% raw %}
\newcommand{\cvsection}[2]{%
  \par\vspace{14pt}\Needspace{6\baselineskip}%
  \noindent\begin{tabularx}{\linewidth}{@{}p{0.85cm}X@{}}
    {\fontsize{8}{10}\selectfont\textcolor{cvpink}{#1}} & {\fontsize{10.5}{13}\selectfont\bfseries\textcolor{cvink}{\MakeUppercase{#2}}}\\[-2.5pt]
  \end{tabularx}\par\vspace{2pt}%
  \noindent\textcolor{cvrule}{\rule{\linewidth}{0.55pt}}\par\vspace{7pt}%
}
\newlist{expitems}{itemize}{1}
\setlist[expitems]{label={\textcolor{cvteal}{\rule{0.38em}{0.38em}}},leftmargin=1.15em,labelsep=0.55em,itemsep=2.15pt,topsep=3.1pt,partopsep=0pt,parsep=0pt}
\newcommand{\cvrole}[5]{%
  \Needspace{8\baselineskip}%
  \noindent\begin{minipage}[t]{0.192\linewidth}
    {\vspace{0pt}\fontsize{8.25}{11.2}\selectfont\textcolor{cvmuted}{#1}\par}\vspace{2pt}
    {\fontsize{7.7}{10.4}\selectfont\textcolor{cvmuted}{#4}}
  \end{minipage}\hfill%
  \begin{minipage}[t]{0.779\linewidth}
    {\vspace{0pt}\fontsize{10.4}{12}\selectfont\bfseries #2\par}\vspace{2pt}
    {\fontsize{9.1}{11.4}\selectfont\textcolor{cvteal}{\bfseries #3}}\par\vspace{3pt}
    {\fontsize{8.7}{11.9}\selectfont\textcolor{cvmuted}{#5}\par}
  \end{minipage}\par\vspace{4pt}
}
\newcommand{\cvdetails}[2]{%
  \noindent\hspace*{0.221\linewidth}%
  \begin{minipage}[t]{0.779\linewidth}
    \vspace{0pt}%
    {\fontsize{8.7}{11.8}\selectfont\begin{expitems}#1\end{expitems}}
    \vspace{2pt}
    {\fontsize{7.8}{10.7}\selectfont\textcolor{cvmuted}{\textbf{Stack} \quad #2}\par}
  \end{minipage}\par\vspace{10pt}
}
\newcommand{\cvskill}[2]{%
  {\fontsize{8.4}{11.5}\selectfont\bfseries #1}\par\vspace{1.4pt}
  {\fontsize{8.35}{11.5}\selectfont\textcolor{cvmuted}{#2}}\par
}
\newcommand{\cvproject}[4]{%
 \Needspace{7\baselineskip}%
 \noindent\begin{minipage}[t]{0.192\linewidth}\vspace{0pt}
 {\fontsize{8.25}{11}\selectfont\textcolor{cvmuted}{PERSONAL PROJECT}}
 \end{minipage}\hfill\begin{minipage}[t]{0.779\linewidth}\vspace{0pt}
  {\fontsize{10.4}{12}\selectfont\bfseries #1}\par\vspace{3pt}
  {\fontsize{8.45}{11}\selectfont\textcolor{cvteal}{#2}}\par\vspace{2pt}
  {\fontsize{8.7}{11.8}\selectfont\begin{expitems}#3\end{expitems}}
  \vspace{1pt}{\fontsize{7.8}{10.6}\selectfont\textcolor{cvmuted}{\textbf{Stack}\quad #4}}\par
 \end{minipage}\par\vspace{9pt}
}
{% endraw %}

